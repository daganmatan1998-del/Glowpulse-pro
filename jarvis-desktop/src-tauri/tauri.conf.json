{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS",
  "version": "1.0.0",
  "identifier": "dev.daganmatan.jarvis",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "JARVIS",
        "width": 180,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "center": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": {
        "NSCameraUsageDescription": "JARVIS looks at what you show him through the camera, and only while you have it switched on.",
        "NSMicrophoneUsageDescription": "JARVIS listens for his name so you can talk to him instead of typing."
      }
    }
  }
}
