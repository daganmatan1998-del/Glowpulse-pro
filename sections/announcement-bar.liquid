{%- liquid
  assign st = section.settings
-%}

{%- if section.blocks.size > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} .announcement {
      background-color: {{ st.background_color }};
      color: {{ st.text_color }};
      font-size: {{ st.font_size }}px;
    }
    #shopify-section-{{ section.id }} .announcement__item + .announcement__item {
      display: none;
    }
  {%- endstyle -%}

  <div class="announcement">
    <div class="page-width">
      <div data-announcement-list>
        {%- for block in section.blocks -%}
          <div class="announcement__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              {% render 'icon', name: block.settings.icon, class: 'announcement__icon' %}
            {%- endif -%}

            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 1 and st.rotate -%}
    <script>
      (function () {
        var list = document.querySelector('#shopify-section-{{ section.id }} [data-announcement-list]');
        if (!list) return;
        var items = list.querySelectorAll('.announcement__item');
        if (items.length < 2) return;
        var index = 0;
        items.forEach(function (item) { item.style.display = 'none'; });
        items[0].style.display = 'flex';
        setInterval(function () {
          items[index].style.display = 'none';
          index = (index + 1) % items.length;
          items[index].style.display = 'flex';
        }, {{ st.rotate_speed | times: 1000 }});
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#14161a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 13
    },
    {
      "type": "checkbox",
      "id": "rotate",
      "label": "Rotate between announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds per announcement",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free worldwide shipping on all orders"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Shield" },
            { "value": "refresh", "label": "Returns" },
            { "value": "percent", "label": "Discount" },
            { "value": "zap", "label": "Lightning" },
            { "value": "gift", "label": "Gift" },
            { "value": "star", "label": "Star" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "lock", "label": "Secure" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "Free worldwide shipping on all orders",
          "icon": "truck"
        }
      }
    ]
  },
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
