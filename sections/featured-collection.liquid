{%- liquid
  assign products = section.settings.collection.products
  assign limit = section.settings.products_to_show

  comment
    "Related" reuses the first collection the current product belongs to, so it
    works on a normal page render without an extra request.
  endcomment
  if section.settings.source == 'related' and product != blank
    assign products = product.collections.first.products | default: collections.all.products
  endif
-%}

<div class="section{% if section.settings.background != 'default' %} section--{{ section.settings.background }}{% endif %}">
  <div class="page-width">
    <div class="section-header{% if section.settings.center_heading %} section-header--center{% endif %} reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p>{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="product-grid product-grid--{{ section.settings.columns }} reveal-group">
        {%- for item in products limit: limit -%}
          {% render 'product-card',
            product: item,
            fallback_rating: section.settings.fallback_rating,
            fallback_count: section.settings.fallback_count,
            lazy: true
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for i in (1..4) -%}
          <div class="card">
            <div class="card__media media media--square">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="card__info">
              <h3 class="card__title">Your product title</h3>
              <div class="price"><span class="price__current">$29.00</span></div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="button-group button-group--center" style="margin-top: 40px;">
        <a
          class="button button--secondary button--large"
          href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "soft", "label": "Soft tint" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products to show",
      "options": [
        { "value": "collection", "label": "From a collection" },
        { "value": "related", "label": "Related products (product pages only)" }
      ],
      "default": "collection"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "checkbox", "id": "center_heading", "label": "Center the heading", "default": true },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "label": "Maximum products",
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all products" },
    { "type": "header", "content": "Rating fallback" },
    {
      "type": "paragraph",
      "content": "Shown only on products that have no rating from a review app yet."
    },
    {
      "type": "range",
      "id": "fallback_rating",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "label": "Fallback rating",
      "default": 0
    },
    { "type": "number", "id": "fallback_count", "label": "Fallback review count", "default": 0 }
  ],
  "presets": [{ "name": "Product grid" }]
}
{% endschema %}
