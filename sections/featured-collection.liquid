{%- liquid
  assign st = section.settings

  assign width_class = 'page-width'
  if st.content_width == 'narrow'
    assign width_class = 'page-width page-width--narrow'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif

  assign header_align_class = ''
  if st.heading_alignment == 'center'
    assign header_align_class = ' section__header--center'
  elsif st.heading_alignment == 'right'
    assign header_align_class = ' section__header--right'
  endif

  assign collection = st.collection
  assign products_to_show = st.products_to_show
-%}

{% render 'section-style', section: section %}

<div class="section">
  <div class="{{ width_class }}">
    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="section__header{{ header_align_class }}">
        {%- if st.subheading != blank -%}
          <span class="eyebrow">{{ st.subheading }}</span>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2>{{ st.heading }}</h2>
        {%- endif -%}
        {%- if st.text != blank -%}
          <div class="rte section__text">{{ st.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="product-grid{% if settings.animations_enabled %} animate-in{% endif %}"
      role="list"
      style="--grid-mobile: {{ st.columns_mobile }}; --grid-desktop: {{ st.columns_desktop }};"
    >
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: products_to_show -%}
          <li>
            {% render 'product-card',
              card_product: product,
              image_ratio: st.image_ratio,
              show_vendor: st.show_vendor,
              show_badges: st.show_badges,
              alignment: st.card_alignment,
              index: forloop.index
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..products_to_show) -%}
          <li>
            {% render 'product-card',
              image_ratio: st.image_ratio,
              alignment: st.card_alignment,
              index: forloop.index
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if st.show_view_all and collection != blank -%}
      <div class="text-center" style="margin-top:32px;">
        <a class="button button--secondary" href="{{ collection.url }}">
          {{ st.view_all_label | default: 'View all' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small label above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show sale and sold out badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" label",
      "default": "View all"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Standard" },
        { "value": "medium", "label": "Medium" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
