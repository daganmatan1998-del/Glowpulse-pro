{%- liquid
  assign st = section.settings
  assign product = st.product

  assign width_class = 'page-width'
  if st.content_width == 'narrow'
    assign width_class = 'page-width page-width--narrow'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif

  assign price_id = 'Price-' | append: section.id
-%}

{% render 'section-style', section: section %}

<div class="section featured-product">
  <div class="{{ width_class }}">
    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="section__header section__header--center">
        {%- if st.subheading != blank -%}
          <span class="eyebrow">{{ st.subheading }}</span>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2>{{ st.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if product != blank -%}
      <div class="product{% if settings.animations_enabled %} animate-in{% endif %}">
        <div class="product__media-wrapper">
          {% render 'product-gallery',
            product: product,
            section_id: section.id,
            image_ratio: st.image_ratio,
            image_fit: st.image_fit,
            max_width: st.media_max_width,
            show_thumbnails: st.show_thumbnails
          %}
        </div>

        <div class="product__info-wrapper">
          <div class="product__info">
            {%- if st.show_vendor and product.vendor != blank -%}
              <span class="eyebrow">{{ product.vendor }}</span>
            {%- endif -%}

            <h3 class="product__title h2">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            {%- if st.show_rating -%}
              <div>
                {% render 'rating-stars', rating: st.rating, label: st.rating_label %}
              </div>
            {%- endif -%}

            <div class="product__price-row">
              {% render 'price',
                product: product,
                price_id: price_id,
                price_section: section.id,
                price_class: 'price--large',
                show_saving: true
              %}
            </div>

            {%- if st.show_description and product.description != blank -%}
              <div class="rte product__description">
                {{ product.description | strip_html | truncatewords: st.description_words }}
              </div>
            {%- endif -%}

            {% render 'variant-picker',
              product: product,
              section_id: section.id,
              picker_type: st.variant_picker_type,
              update_url: false
            %}

            {% render 'buy-buttons',
              product: product,
              section_id: section.id,
              show_quantity: st.show_quantity,
              show_dynamic: st.show_dynamic_checkout
            %}

            {%- if st.show_view_details -%}
              <a class="link-arrow" href="{{ product.url }}">
                {{ 'products.product.view_full_details' | t }}
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}

            {%- if section.blocks.size > 0 -%}
              <ul class="footer__list" style="margin-top:4px;" role="list">
                {%- for block in section.blocks -%}
                  <li
                    style="display:flex;gap:10px;align-items:flex-start;"
                    {{ block.shopify_attributes }}
                  >
                    <span class="benefit__icon" style="--benefit-icon-size: 20px;">
                      {% render 'icon', name: block.settings.icon %}
                    </span>
                    <span class="text-small">{{ block.settings.text }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- else -%}
      <div class="product">
        <div class="media media--square">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
        <div class="product__info">
          <h3 class="h2">{{ 'onboarding.product_title' | t }}</h3>
          <p class="text-muted">{{ 'onboarding.product_description' | t }}</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "section-featured-product",
  "max_blocks": 5,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small label above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best seller"
    },
    {
      "type": "header",
      "content": "Product details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "select",
      "id": "rating",
      "label": "Rating",
      "options": [
        { "value": "5", "label": "5.0" },
        { "value": "4.9", "label": "4.9" },
        { "value": "4.8", "label": "4.8" },
        { "value": "4.7", "label": "4.7" },
        { "value": "4.5", "label": "4.5" },
        { "value": "4.3", "label": "4.3" },
        { "value": "4", "label": "4.0" },
        { "value": "3.5", "label": "3.5" }
      ],
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating label",
      "default": "1,284 reviews"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "range",
      "id": "description_words",
      "min": 10,
      "max": 120,
      "step": 5,
      "label": "Description length (words)",
      "default": 40
    },
    {
      "type": "select",
      "id": "variant_picker_type",
      "label": "Variant picker style",
      "options": [
        { "value": "button", "label": "Buttons" },
        { "value": "dropdown", "label": "Dropdowns" }
      ],
      "default": "button"
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Buy it now button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_details",
      "label": "Show \"View full details\" link",
      "default": true
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "tall", "label": "Tall (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill the frame (crop)" },
        { "value": "contain", "label": "Show the whole image" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "media_max_width",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Maximum image width",
      "default": 560
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnails on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Standard" },
        { "value": "medium", "label": "Medium" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight line",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Secure checkout" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "clock", "label": "Fast" },
            { "value": "award", "label": "Award" },
            { "value": "heart", "label": "Loved" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free tracked shipping worldwide"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured product",
      "blocks": [
        { "type": "highlight" },
        { "type": "highlight", "settings": { "icon": "refresh", "text": "30-day free returns" } }
      ]
    }
  ]
}
{% endschema %}
