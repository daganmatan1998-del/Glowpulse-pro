{%- liquid
  assign st = section.settings
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .footer {
    --footer-background: {{ st.background_color }};
    --footer-text: {{ st.text_color }};
    --color-border: {{ st.border_color }};
    padding-top: {{ st.padding_top_mobile }}px;
    padding-bottom: {{ st.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .footer {
      padding-top: {{ st.padding_top }}px;
      padding-bottom: {{ st.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer" role="contentinfo">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__blocks">
        {%- for block in section.blocks -%}
          <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- if block.settings.logo != blank -%}
                  <div class="footer__logo">
                    <img
                      src="{{ block.settings.logo | image_url: width: 400 }}"
                      alt="{{ block.settings.logo.alt | escape | default: shop.name | escape }}"
                      width="{{ block.settings.logo.width }}"
                      height="{{ block.settings.logo.height }}"
                      style="width: {{ block.settings.logo_width }}px; max-width: 100%;"
                      loading="lazy"
                    >
                  </div>
                {%- elsif block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading }}</p>
                {%- endif -%}

                {%- if block.settings.text != blank -%}
                  <div class="rte footer__text">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- if block.settings.show_social -%}
                  <div style="margin-top:16px;">{% render 'social-icons' %}</div>
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__list" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'policies' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="footer__list" role="list">
                  {%- for policy in shop.policies -%}
                    {%- if policy != blank -%}
                      <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                <ul class="footer__list" role="list">
                  {%- if block.settings.email != blank -%}
                    <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    <li>
                      <a href="tel:{{ block.settings.phone | replace: ' ', '' }}">{{ block.settings.phone }}</a>
                    </li>
                  {%- endif -%}
                </ul>
                {%- if block.settings.text != blank -%}
                  <div class="rte footer__text" style="margin-top:10px;">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte footer__text">{{ block.settings.text }}</div>
                {%- endif -%}

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <p class="footer__block-title">{{ block.settings.heading }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte footer__text" style="margin-bottom:14px;">{{ block.settings.text }}</div>
                {%- endif -%}

                {%- form 'customer', class: 'newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="field">
                    <label class="visually-hidden" for="FooterNewsletter-{{ block.id }}">
                      {{ 'general.newsletter_form.email_placeholder' | t }}
                    </label>
                    <input
                      class="field__input"
                      id="FooterNewsletter-{{ block.id }}"
                      type="email"
                      name="contact[email]"
                      autocomplete="email"
                      placeholder="{{ 'general.newsletter_form.email_placeholder' | t | escape }}"
                      required
                    >
                  </div>
                  <button type="submit" class="button">
                    {{ block.settings.button_label | default: 'Subscribe' }}
                  </button>

                  {%- if form.posted_successfully? -%}
                    <p class="form__message form__message--success">
                      {{ 'general.newsletter_form.confirmation' | t }}
                    </p>
                  {%- elsif form.errors -%}
                    <p class="form__message form__message--error">
                      {{ 'general.newsletter_form.error' | t }}
                    </p>
                  {%- endif -%}
                {%- endform -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <div>
        <span>
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
          {%- if st.copyright_text != blank %} {{ st.copyright_text }}{% else %} {{ 'sections.footer.copyright' | t }}{% endif -%}
        </span>
        {%- if st.show_powered_by -%}
          <span>{{ powered_by_link }}</span>
        {%- endif -%}
      </div>

      {%- if st.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="footer__payment">
          <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#14161a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#e4e4e1"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text",
      "default": "All rights reserved."
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show \"Powered by Shopify\"",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Logo and about text",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 60,
          "max": 260,
          "step": 5,
          "unit": "px",
          "label": "Logo width",
          "default": 130
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Used when no logo is set."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "About text",
          "default": "<p>Thoughtfully made products, shipped worldwide with tracked delivery and a 30-day guarantee.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": true
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "policies",
      "name": "Store policies",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Policies"
        },
        {
          "type": "paragraph",
          "content": "Automatically lists the policies published in Settings → Policies."
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact details",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact"
        },
        {
          "type": "text",
          "id": "email",
          "label": "Email address"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone number"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Additional text",
          "default": "<p>Support available Monday to Friday.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Share shipping times, guarantees or anything else customers ask about.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Stay in the loop"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Early access to new drops and subscriber-only offers.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Subscribe"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
