{%- liquid
  assign st = section.settings

  assign width_class = 'page-width'
  if st.content_width == 'narrow'
    assign width_class = 'page-width page-width--narrow'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  elsif st.content_width == 'full'
    assign width_class = 'page-width page-width--full'
  endif

  assign header_align_class = ''
  if st.text_alignment == 'center'
    assign header_align_class = ' section__header--center'
  elsif st.text_alignment == 'right'
    assign header_align_class = ' section__header--right'
  endif
-%}

{% render 'section-style', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} .section__heading {
    font-size: {{ st.heading_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .section__heading {
      font-size: {{ st.heading_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="section">
  <div class="{{ width_class }}">
    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="section__header{{ header_align_class }}">
        {%- if st.subheading != blank -%}
          <span class="eyebrow">{{ st.subheading }}</span>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2 class="section__heading">{{ st.heading }}</h2>
        {%- endif -%}
        {%- if st.text != blank -%}
          <div class="rte section__text">{{ st.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="image-gallery{% if settings.animations_enabled %} animate-in{% endif %}"
        style="
          --gallery-cols-mobile: {{ st.columns_mobile }};
          --gallery-cols-desktop: {{ st.columns_desktop }};
          --gallery-gap: {{ st.gap_mobile }}px;
          --gallery-gap-desktop: {{ st.gap_desktop }}px;
        "
      >
        {%- for block in section.blocks -%}
          <div class="image-gallery__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" aria-label="{{ block.settings.link_label | escape }}">
            {%- endif -%}

            {% render 'responsive-image',
              image: block.settings.image,
              image_mobile: block.settings.image_mobile,
              ratio_desktop: st.image_ratio_desktop,
              ratio_mobile: st.image_ratio_mobile,
              fit: st.image_fit,
              radius: st.image_radius,
              sizes: '(min-width: 750px) 33vw, 50vw',
              alt: block.settings.alt,
              placeholder: 'lifestyle-2'
            %}

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}

            {%- if block.settings.caption != blank -%}
              <p class="image-gallery__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Image gallery",
  "tag": "section",
  "class": "section-image-gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small label above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In real life"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "Image shape on desktop",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "tall", "label": "Tall (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_ratio_mobile",
      "label": "Image shape on mobile",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "tall", "label": "Tall (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill the frame (crop)" },
        { "value": "contain", "label": "Show the whole image" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image corner radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Images per row on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Images per row on desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap (mobile)",
      "default": 10
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap (desktop)",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Standard" },
        { "value": "medium", "label": "Medium" },
        { "value": "narrow", "label": "Narrow" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image",
          "info": "Optional."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link description",
          "default": "View more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image gallery",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
