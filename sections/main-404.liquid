{% render 'section-style', section: section %}

<div class="section">
  <div class="page-width page-width--narrow">
    <div class="cta">
      <h1>{{ section.settings.heading | default: '404' }}</h1>
      <p class="h3">{{ 'general.404.title' | t }}</p>
      <p class="text-muted">{{ section.settings.text | default: 'The page you are looking for does not exist or has moved.' }}</p>
      <a class="button" href="{{ section.settings.button_link | default: routes.root_url }}">
        {{ section.settings.button_label | default: 'Continue shopping' }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "404"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The page you are looking for does not exist or has moved."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Continue shopping"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 64
    }
  ]
}
{% endschema %}
