{%- liquid
  assign st = section.settings

  assign width_class = 'page-width page-width--narrow'
  if st.content_width == 'page'
    assign width_class = 'page-width'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif
-%}

{% render 'section-style', section: section %}

<div class="section">
  <div class="{{ width_class }}">
    <div class="section__header{% if st.heading_alignment == 'center' %} section__header--center{% endif %}">
      <h1>{{ page.title }}</h1>
    </div>

    {%- if st.image != blank -%}
      <div style="margin-bottom:28px;">
        {% render 'responsive-image',
          image: st.image,
          ratio_desktop: 'wide',
          ratio_mobile: 'landscape',
          sizes: '(min-width: 750px) 820px, 100vw',
          placeholder: 'lifestyle-1'
        %}
      </div>
    {%- endif -%}

    <div class="rte">{{ page.content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "class": "section-main-page",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "medium", "label": "Medium" },
        { "value": "page", "label": "Standard" }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    }
  ]
}
{% endschema %}
