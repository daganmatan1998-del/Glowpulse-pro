<div class="page-width page-width--narrow" style="text-align:center;">
  {%- if section.settings.logo != blank -%}
    <img
      src="{{ section.settings.logo | image_url: width: 600 }}"
      alt="{{ shop.name | escape }}"
      width="{{ section.settings.logo.width }}"
      height="{{ section.settings.logo.height }}"
      style="width: {{ section.settings.logo_width }}px; max-width: 100%; margin: 0 auto 28px;"
      loading="eager"
    >
  {%- else -%}
    <h1 style="margin-bottom:20px;">{{ shop.name }}</h1>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <h2 class="h2" style="margin-bottom:12px;">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.text != blank -%}
    <div class="rte text-muted" style="margin-bottom:28px;">{{ section.settings.text }}</div>
  {%- endif -%}

  {%- form 'storefront_password', class: 'form-stack' -%}
    {%- if form.errors -%}
      <p class="form__message form__message--error">
        {{ 'general.password_page.login_form_error' | t }}
      </p>
    {%- endif -%}

    <div class="field">
      <label class="visually-hidden" for="StorefrontPassword">
        {{ 'general.password_page.login_form_password_label' | t }}
      </label>
      <input
        class="field__input"
        id="StorefrontPassword"
        type="password"
        name="password"
        autocomplete="current-password"
        placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | escape }}"
        required
      >
    </div>

    <button type="submit" class="button button--full">
      {{ 'general.password_page.login_form_submit' | t }}
    </button>
  {%- endform -%}

  <p class="text-small text-muted" style="margin-top:24px;">
    {{ 'general.password_page.admin_link_html' | t }}
  </p>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 160
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We are putting the finishing touches on the store. Check back shortly.</p>"
    }
  ]
}
{% endschema %}
