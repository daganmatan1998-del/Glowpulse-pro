{%- liquid
  assign st = section.settings
  assign variant = product.selected_or_first_available_variant

  assign width_class = 'page-width'
  if st.content_width == 'narrow'
    assign width_class = 'page-width page-width--narrow'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif

  assign price_id = 'Price-' | append: section.id
-%}

{% render 'section-style', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} .product__title {
    font-size: {{ st.title_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .product__title {
      font-size: {{ st.title_size_desktop }}px;
    }
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .product {
      grid-template-columns: minmax(0, {{ st.media_width }}fr) minmax(0, {{ 100 | minus: st.media_width }}fr);
    }
  }
{%- endstyle -%}

<div class="section">
  <div class="{{ width_class }}">
    <div class="product">
      <div class="product__media-wrapper">
        {% render 'product-gallery',
          product: product,
          section_id: section.id,
          image_ratio: st.image_ratio,
          image_fit: st.image_fit,
          max_width: st.media_max_width,
          show_thumbnails: st.show_thumbnails
        %}
      </div>

      <div class="product__info-wrapper">
        <div class="product__info">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  <span class="eyebrow" {{ block.shopify_attributes }}>{{ product.vendor }}</span>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

              {%- when 'rating' -%}
                <div {{ block.shopify_attributes }}>
                  {% render 'rating-stars', rating: block.settings.rating, label: block.settings.label %}
                </div>

              {%- when 'price' -%}
                <div class="product__price-row" {{ block.shopify_attributes }}>
                  {% render 'price',
                    product: product,
                    price_id: price_id,
                    price_section: section.id,
                    price_class: 'price--large',
                    show_saving: block.settings.show_saving
                  %}
                </div>
                {%- if block.settings.show_tax_note -%}
                  <p class="text-small text-muted" style="margin-top:-10px;">
                    {{ 'products.product.taxes_included' | t }}
                    {{ 'products.product.shipping_at_checkout' | t }}
                  </p>
                {%- endif -%}

              {%- when 'short_text' -%}
                <div class="rte product__description" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </div>

              {%- when 'variant_picker' -%}
                <div {{ block.shopify_attributes }}>
                  {% render 'variant-picker',
                    product: product,
                    section_id: section.id,
                    picker_type: block.settings.picker_type
                  %}
                </div>

              {%- when 'buy_buttons' -%}
                <div data-sticky-atc-anchor {{ block.shopify_attributes }}>
                  {%- if block.settings.show_inventory and variant.available -%}
                    <p class="text-small" style="display:flex;align-items:center;gap:6px;margin-bottom:10px;">
                      <span
                        style="width:8px;height:8px;border-radius:50%;background:#12855b;display:inline-block;"
                        aria-hidden="true"
                      ></span>
                      {%- if variant.inventory_management != blank
                        and variant.inventory_policy == 'deny'
                        and variant.inventory_quantity > 0
                        and variant.inventory_quantity <= block.settings.low_stock_threshold
                      -%}
                        {{ 'products.product.low_stock' | t }}
                      {%- else -%}
                        {{ 'products.product.in_stock' | t }}
                      {%- endif -%}
                    </p>
                  {%- endif -%}

                  {% render 'buy-buttons',
                    product: product,
                    section_id: section.id,
                    show_quantity: block.settings.show_quantity,
                    show_dynamic: block.settings.show_dynamic_checkout
                  %}
                </div>

              {%- when 'highlight' -%}
                <div
                  style="display:flex;gap:10px;align-items:flex-start;"
                  {{ block.shopify_attributes }}
                >
                  <span class="benefit__icon" style="--benefit-icon-size: 20px;">
                    {% render 'icon', name: block.settings.icon %}
                  </span>
                  <span class="text-small">{{ block.settings.text }}</span>
                </div>

              {%- when 'description' -%}
                <div class="rte product__description" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>

              {%- when 'collapsible' -%}
                <div class="product__accordion" data-accordion-group {{ block.shopify_attributes }}>
                  <div class="accordion">
                    <details class="accordion__item" {% if block.settings.open %}open{% endif %}>
                      <summary class="accordion__summary">
                        <span style="display:flex;align-items:center;gap:10px;">
                          {%- if block.settings.icon != 'none' -%}
                            <span class="benefit__icon" style="--benefit-icon-size: 19px;">
                              {% render 'icon', name: block.settings.icon %}
                            </span>
                          {%- endif -%}
                          {{ block.settings.heading }}
                        </span>
                        <span class="accordion__icon" aria-hidden="true"></span>
                      </summary>
                      <div class="accordion__content rte">
                        {{ block.settings.content }}
                        {%- if block.settings.page != blank -%}
                          {{ block.settings.page.content }}
                        {%- endif -%}
                      </div>
                    </details>
                  </div>
                </div>

              {%- when 'sku' -%}
                {%- if variant.sku != blank -%}
                  <p class="text-small text-muted" {{ block.shopify_attributes }}>
                    {{ 'products.product.sku' | t }}: {{ variant.sku }}
                  </p>
                {%- endif -%}

              {%- when 'custom_liquid' -%}
                <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

              {%- when '@app' -%}
                <div {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%} Sticky add to cart, mainly for mobile {%- endcomment -%}
{%- if st.enable_sticky_atc and product != blank -%}
  <div class="sticky-atc" data-sticky-atc>
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title }}</span>
      {% render 'price', product: product, price_section: section.id, price_class: 'text-small' %}
    </div>
    <button
      type="submit"
      form="product-form-{{ section.id }}"
      class="button sticky-atc__button"
      data-add-to-cart
      data-section="{{ section.id }}"
      {% if variant.available == false %}disabled{% endif %}
    >
      <span class="button__label">
        {%- if variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
      <span class="button__spinner" aria-hidden="true"></span>
    </button>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "tall", "label": "Tall (3:4)" },
        { "value": "landscape", "label": "Landscape (4:3)" }
      ],
      "default": "square"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill the frame (crop)" },
        { "value": "contain", "label": "Show the whole image" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "media_max_width",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Maximum image width",
      "default": 600,
      "info": "Stops product photos from stretching across wide screens."
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 35,
      "max": 65,
      "step": 5,
      "unit": "%",
      "label": "Image column width on desktop",
      "default": 55
    },
    {
      "type": "checkbox",
      "id": "show_thumbnails",
      "label": "Show thumbnails on desktop",
      "default": true
    },
    {
      "type": "header",
      "content": "Buy bar"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_atc",
      "label": "Show sticky add to cart bar",
      "default": true,
      "info": "Appears once the main buy button scrolls out of view."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Product title size (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 18,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Product title size (desktop)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Standard" },
        { "value": "medium", "label": "Medium" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "page"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Star rating",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "rating",
          "label": "Rating",
          "options": [
            { "value": "5", "label": "5.0" },
            { "value": "4.9", "label": "4.9" },
            { "value": "4.8", "label": "4.8" },
            { "value": "4.7", "label": "4.7" },
            { "value": "4.5", "label": "4.5" },
            { "value": "4.3", "label": "4.3" },
            { "value": "4", "label": "4.0" }
          ],
          "default": "4.8"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "1,284 reviews"
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_saving",
          "label": "Show saving badge",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_tax_note",
          "label": "Show tax and shipping note",
          "default": true
        }
      ]
    },
    {
      "type": "short_text",
      "name": "Short text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A one-line summary of why this product is worth buying.</p>"
        }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Style",
          "options": [
            { "value": "button", "label": "Buttons" },
            { "value": "dropdown", "label": "Dropdowns" }
          ],
          "default": "button"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Show quantity selector",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show Buy it now button",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_inventory",
          "label": "Show stock status",
          "default": true
        },
        {
          "type": "range",
          "id": "low_stock_threshold",
          "min": 1,
          "max": 30,
          "step": 1,
          "label": "Show \"Low stock\" under this quantity",
          "default": 10
        }
      ]
    },
    {
      "type": "highlight",
      "name": "Highlight line",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Check" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "refresh", "label": "Returns" },
            { "value": "lock", "label": "Secure checkout" },
            { "value": "clock", "label": "Fast dispatch" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "headset", "label": "Support" },
            { "value": "award", "label": "Award" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free tracked shipping worldwide"
        }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shipping information"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "refresh", "label": "Returns" },
            { "value": "box", "label": "Package" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "info", "label": "Information" },
            { "value": "headset", "label": "Support" },
            { "value": "tag", "label": "Specifications" }
          ],
          "default": "truck"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Orders are dispatched within 24 hours. Delivery takes 5–9 business days with tracking included.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Or show a page",
          "info": "Content from this page is added below the text above."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "sku",
      "name": "SKU",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid",
          "info": "Add app snippets or your own Liquid here."
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
