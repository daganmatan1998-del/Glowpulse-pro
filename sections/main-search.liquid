{%- liquid
  assign st = section.settings
-%}

{% render 'section-style', section: section %}

<div class="section">
  <div class="page-width">
    <div class="section__header section__header--center">
      <h1>{{ 'general.search.search' | t }}</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="newsletter-form newsletter-form--inline">
        <div class="field">
          <label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
          <input
            class="field__input"
            id="SearchInput"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t | escape }}"
          >
        </div>
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="button">{{ 'general.search.submit' | t }}</button>
      </form>
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="collection__count text-center" style="margin-bottom:24px;">
          {{ 'general.search.results_with_count' | t: count: search.results_count }}
        </p>

        {%- paginate search.results by st.results_per_page -%}
          <ul
            class="product-grid"
            role="list"
            style="--grid-mobile: {{ st.columns_mobile }}; --grid-desktop: {{ st.columns_desktop }};"
          >
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', card_product: item, index: forloop.index %}
                {%- else -%}
                  <div class="article-card">
                    {%- if item.image -%}
                      <a href="{{ item.url }}" class="media media--landscape">
                        <img
                          src="{{ item.image | image_url: width: 600 }}"
                          alt="{{ item.title | escape }}"
                          width="600"
                          height="450"
                          loading="lazy"
                        >
                      </a>
                    {%- endif -%}
                    <h3 class="article-card__title">
                      <a href="{{ item.url }}">{{ item.title }}</a>
                    </h3>
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>

          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- else -%}
        <p class="text-center text-muted" style="padding:48px 0;">
          {{ 'general.search.no_results' | t: terms: search.terms }}
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Results per page",
      "default": 16
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 40
    }
  ]
}
{% endschema %}
