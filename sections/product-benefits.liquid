{%- liquid
  assign st = section.settings

  assign width_class = 'page-width'
  if st.content_width == 'narrow'
    assign width_class = 'page-width page-width--narrow'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif

  assign header_align_class = ''
  if st.heading_alignment == 'center'
    assign header_align_class = ' section__header--center'
  elsif st.heading_alignment == 'right'
    assign header_align_class = ' section__header--right'
  endif

  assign benefit_class = 'benefit'
  if st.layout == 'stacked'
    assign benefit_class = 'benefit benefit--stacked'
  elsif st.layout == 'center'
    assign benefit_class = 'benefit benefit--center'
  endif
  if st.boxed
    assign benefit_class = benefit_class | append: ' benefit--boxed'
  endif

  assign columns_desktop = st.columns_desktop
  if section.blocks.size < columns_desktop
    assign columns_desktop = section.blocks.size
  endif
  if columns_desktop < 1
    assign columns_desktop = 1
  endif
-%}

{% render 'section-style', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} .benefit__title {
    font-size: {{ st.title_size_mobile }}px;
  }
  #shopify-section-{{ section.id }} .benefit__text {
    font-size: {{ st.text_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .benefit__title {
      font-size: {{ st.title_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .benefit__text {
      font-size: {{ st.text_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="section">
  <div class="{{ width_class }}">
    {%- if st.heading != blank or st.subheading != blank or st.text != blank -%}
      <div class="section__header{{ header_align_class }}">
        {%- if st.subheading != blank -%}
          <span class="eyebrow">{{ st.subheading }}</span>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2>{{ st.heading }}</h2>
        {%- endif -%}
        {%- if st.text != blank -%}
          <div class="rte section__text">{{ st.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="benefits{% if settings.animations_enabled %} animate-in{% endif %}"
        style="
          --benefits-mobile: {{ st.columns_mobile }};
          --benefits-desktop: {{ columns_desktop }};
          --benefit-icon-size: {{ st.icon_size }}px;
        "
      >
        {%- for block in section.blocks -%}
          <div class="{{ benefit_class }}" {{ block.shopify_attributes }}>
            {%- if st.show_icons -%}
              <span class="benefit__icon" style="color: {{ st.icon_color }};">
                {%- if block.settings.custom_icon != blank -%}
                  <img
                    src="{{ block.settings.custom_icon | image_url: width: 120 }}"
                    alt=""
                    width="60"
                    height="60"
                    loading="lazy"
                  >
                {%- else -%}
                  {% render 'icon', name: block.settings.icon %}
                {%- endif -%}
              </span>
            {%- endif -%}

            <div>
              {%- if block.settings.title != blank -%}
                <h3 class="benefit__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte benefit__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product benefits",
  "tag": "section",
  "class": "section-benefits",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
