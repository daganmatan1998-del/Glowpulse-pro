    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Benefit layout",
      "options": [
        { "value": "inline", "label": "Icon beside text" },
        { "value": "stacked", "label": "Icon above text" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "boxed",
      "label": "Show a border around each benefit",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "default": 1
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icons",
      "default": true
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Icon size",
      "default": 30
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#14161a"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "min": 13,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Benefit title size (mobile)",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "min": 14,
      "max": 34,
      "step": 1,
      "unit": "px",
      "label": "Benefit title size (desktop)",
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Benefit text size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Benefit text size (desktop)",
      "default": 15
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Standard" },
        { "value": "medium", "label": "Medium" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "page"
