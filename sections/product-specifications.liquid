{%- liquid
  assign st = section.settings

  assign width_class = 'page-width page-width--narrow'
  if st.content_width == 'page'
    assign width_class = 'page-width'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif

  assign header_align_class = ''
  if st.heading_alignment == 'center'
    assign header_align_class = ' section__header--center'
  elsif st.heading_alignment == 'right'
    assign header_align_class = ' section__header--right'
  endif
-%}

{% render 'section-style', section: section %}

<div class="section">
  <div class="{{ width_class }}">
    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="section__header{{ header_align_class }}">
        {%- if st.subheading != blank -%}
          <span class="eyebrow">{{ st.subheading }}</span>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2>{{ st.heading }}</h2>
        {%- endif -%}
        {%- if st.text != blank -%}
          <div class="rte section__text">{{ st.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if st.image != blank -%}
      <div style="margin-bottom:24px;">
        {% render 'responsive-image',
          image: st.image,
          ratio_desktop: 'landscape',
          ratio_mobile: 'square',
          fit: 'contain',
          sizes: '(min-width: 750px) 800px, 100vw',
          alt: st.image_alt,
          placeholder: 'product-2'
        %}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="spec-table{% if settings.animations_enabled %} animate-in{% endif %}">
        {%- for block in section.blocks -%}
          <div class="spec-table__row" {{ block.shopify_attributes }}>
            <span class="spec-table__label">{{ block.settings.label }}</span>
            <span class="spec-table__value">{{ block.settings.value }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if st.note != blank -%}
      <p class="text-small text-muted" style="margin-top:16px;">{{ st.note }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product specifications",
  "tag": "section",
  "class": "section-specifications",
  "max_blocks": 20,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small label above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Specifications"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Diagram or product image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt text"
    },
    {
      "type": "header",
      "content": "Footnote"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note below the table",
      "default": "Measurements are approximate and may vary slightly."
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "medium", "label": "Medium" },
        { "value": "page", "label": "Standard" }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Material"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "Anodised aluminium and recycled ABS"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product specifications",
      "blocks": [
        { "type": "spec" },
        { "type": "spec", "settings": { "label": "Dimensions", "value": "182 × 74 × 9 mm" } },
        { "type": "spec", "settings": { "label": "Weight", "value": "245 g" } },
        { "type": "spec", "settings": { "label": "In the box", "value": "Device, USB-C cable, quick start guide" } }
      ]
    }
  ]
}
{% endschema %}
