{%- liquid
  assign st = section.settings

  assign width_class = 'page-width page-width--narrow'
  if st.content_width == 'page'
    assign width_class = 'page-width'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif

  assign flex_align = 'center'
  if st.text_alignment == 'left'
    assign flex_align = 'flex-start'
  elsif st.text_alignment == 'right'
    assign flex_align = 'flex-end'
  endif
-%}

{% render 'section-style', section: section %}

{%- style -%}
  #shopify-section-{{ section.id }} .cta__heading {
    font-size: {{ st.heading_size_mobile }}px;
  }
  #shopify-section-{{ section.id }} .cta__text {
    font-size: {{ st.text_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .cta__heading {
      font-size: {{ st.heading_size_desktop }}px;
    }
    #shopify-section-{{ section.id }} .cta__text {
      font-size: {{ st.text_size_desktop }}px;
    }
  }
{%- endstyle -%}

<div class="section">
  <div class="{{ width_class }}">
    <div
      class="cta{% if settings.animations_enabled %} animate-in{% endif %}"
      style="--content-align: {{ flex_align }}; --content-text-align: {{ st.text_alignment }};"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <span class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- when 'heading' -%}
            <h2 class="cta__heading" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
          {%- when 'text' -%}
            <div class="rte cta__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}
            <div {{ block.shopify_attributes }}>
              <a
                class="button{% if block.settings.style == 'secondary' %} button--secondary{% endif %}"
                href="{{ block.settings.link | default: '#' }}"
              >
                {{ block.settings.label }}
              </a>
            </div>
          {%- when 'divider' -%}
            <hr class="divider" style="width:100%;" {{ block.shopify_attributes }}>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "class": "section-rich-text",
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Heading size (mobile)",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 18,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading size (desktop)",
      "default": 34
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Text size (mobile)",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "min": 13,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Text size (desktop)",
      "default": 17
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "narrow", "label": "Narrow" },
        { "value": "medium", "label": "Medium" },
        { "value": "page", "label": "Standard" }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "section_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Section corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Small label",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Our promise"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Heading",
          "default": "A better way to shop"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this space to tell your story, explain your guarantee, or answer the question customers ask most.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Primary" },
            { "value": "secondary", "label": "Secondary" }
          ],
          "default": "primary"
        }
      ]
    },
    {
      "type": "divider",
      "name": "Divider",
      "settings": []
    }
  ],
  "presets": [
    {
      "name": "Rich text",
      "blocks": [{ "type": "heading" }, { "type": "text" }]
    }
  ]
}
{% endschema %}
