{%- liquid
  assign st = section.settings

  assign width_class = 'page-width'
  if st.content_width == 'narrow'
    assign width_class = 'page-width page-width--narrow'
  elsif st.content_width == 'medium'
    assign width_class = 'page-width page-width--medium'
  endif

  assign header_align_class = ''
  if st.heading_alignment == 'center'
    assign header_align_class = ' section__header--center'
  elsif st.heading_alignment == 'right'
    assign header_align_class = ' section__header--right'
  endif

  assign columns_desktop = st.columns_desktop
  if section.blocks.size < columns_desktop
    assign columns_desktop = section.blocks.size
  endif
  if columns_desktop < 1
    assign columns_desktop = 1
  endif
-%}

{% render 'section-style', section: section %}

<div class="section">
  <div class="{{ width_class }}">
    {%- if st.heading != blank or st.subheading != blank -%}
      <div class="section__header{{ header_align_class }}">
        {%- if st.subheading != blank -%}
          <span class="eyebrow">{{ st.subheading }}</span>
        {%- endif -%}
        {%- if st.heading != blank -%}
          <h2>{{ st.heading }}</h2>
        {%- endif -%}
        {%- if st.text != blank -%}
          <div class="rte section__text">{{ st.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="shipping-info{% if settings.animations_enabled %} animate-in{% endif %}"
        style="--shipping-cols: {{ columns_desktop }};"
      >
        {%- for block in section.blocks -%}
          <div class="shipping-info__item" {{ block.shopify_attributes }}>
            <span class="shipping-info__icon" style="color: {{ st.icon_color }};">
              {% render 'icon', name: block.settings.icon %}
            </span>
            <div>
              {%- if block.settings.title != blank -%}
                <h3 class="benefit__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte benefit__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if st.policy_link_label != blank -%}
      <div class="{% if st.heading_alignment == 'center' %}text-center{% endif %}" style="margin-top:24px;">
        <a class="link-arrow" href="{{ st.policy_link | default: '#' }}">
          {{ st.policy_link_label }}
          {% render 'icon', name: 'arrow-right' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shipping information",
  "tag": "section",
  "class": "section-shipping",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Small label above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shipping and delivery"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon colour",
      "default": "#14161a"
    },
    {
      "type": "header",
      "content": "Policy link"
    },
    {
      "type": "text",
      "id": "policy_link_label",
      "label": "Link label",
      "default": "Read the full shipping policy"
    },
    {
      "type": "url",
      "id": "policy_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Section width",
      "options": [
        { "value": "page", "label": "Standard" },
        { "value": "medium", "label": "Medium" },
        { "value": "narrow", "label": "Narrow" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "section_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Section corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (desktop)",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding (mobile)",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding (mobile)",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Information",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "plane", "label": "Air mail" },
            { "value": "box", "label": "Package" },
            { "value": "clock", "label": "Processing time" },
            { "value": "globe", "label": "Worldwide" },
            { "value": "refresh", "label": "Returns" },
            { "value": "map-pin", "label": "Tracking" },
            { "value": "shield", "label": "Guarantee" },
            { "value": "credit-card", "label": "Payment" },
            { "value": "headset", "label": "Support" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free worldwide delivery"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>All orders ship free with tracking, no minimum spend.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping information",
      "blocks": [
        { "type": "item" },
        {
          "type": "item",
          "settings": {
            "icon": "clock",
            "title": "Dispatched in 24 hours",
            "text": "<p>Orders placed before 3pm ship the same working day.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "refresh",
            "title": "30-day returns",
            "text": "<p>Not right for you? Return it for a full refund within 30 days.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
