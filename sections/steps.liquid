<div class="section{% if section.settings.background != 'default' %} section--{{ section.settings.background }}{% endif %}">
  <div class="page-width">
    <div class="section-header section-header--center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p>{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="steps steps--{{ section.blocks.size }} reveal-group">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          <span class="step__number">
            {%- if section.settings.show_icons -%}
              {% render 'icon', name: block.settings.icon %}
            {%- else -%}
              {{ forloop.index }}
            {%- endif -%}
          </span>
          <h3>{{ block.settings.heading }}</h3>
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="button-group button-group--center" style="margin-top: 44px;">
        <a class="button button--large" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "soft", "label": "Soft tint" },
        { "value": "surface", "label": "Surface" }
      ],
      "default": "soft"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From cart to doorstep in three steps" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "checkbox", "id": "show_icons", "label": "Show icons instead of numbers", "default": false },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your favourite" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Choose the colour and size that suit you and add it to your cart."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "tag", "label": "Tag" },
            { "value": "credit-card", "label": "Payment" },
            { "value": "package", "label": "Package" },
            { "value": "truck", "label": "Delivery" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkles", "label": "Sparkles" }
          ],
          "default": "tag"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "heading": "Pick your favourite",
            "text": "Choose the colour and size that suit you and add it to your cart.",
            "icon": "tag"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Check out securely",
            "text": "Pay with card, PayPal, Apple Pay or Google Pay. Your details are encrypted.",
            "icon": "credit-card"
          }
        },
        {
          "type": "step",
          "settings": {
            "heading": "Track it to your door",
            "text": "We dispatch within 48 hours and email you a tracking link straight away.",
            "icon": "truck"
          }
        }
      ]
    }
  ]
}
{% endschema %}
