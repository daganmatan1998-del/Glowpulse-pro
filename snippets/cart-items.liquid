{%- comment -%}
  Renders the cart line items. Used by both the cart drawer and the cart page.

  Accepts:
  - context: {String} 'drawer' or 'page' — only affects the quantity size

  Usage:
  {% render 'cart-items', context: 'drawer' %}
{%- endcomment -%}

<cart-items class="cart-items-wrapper">
  <ul class="cart-items" role="list">
    {%- for item in cart.items -%}
      {%- liquid
        assign line_number = item.index | plus: 1
        assign quantity_id = 'CartQuantity-' | append: context | append: '-' | append: line_number
      -%}
      <li class="cart-item" id="CartItem-{{ line_number }}">
        <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
          <span class="media media--square">
            {%- if item.image -%}
              <img
                src="{{ item.image | image_url: width: 200 }}"
                alt="{{ item.image.alt | escape }}"
                width="100"
                height="100"
                loading="lazy"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
        </a>

        <div class="cart-item__details">
          <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

          {%- unless item.product.has_only_default_variant -%}
            <span class="cart-item__variant">{{ item.variant.title }}</span>
          {%- endunless -%}

          {%- if item.selling_plan_allocation -%}
            <span class="cart-item__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
          {%- endif -%}

          {%- if item.properties != blank -%}
            {%- for property in item.properties -%}
              {%- assign first_character = property.first | slice: 0 -%}
              {%- if property.last != blank and first_character != '_' -%}
                <span class="cart-item__variant">{{ property.first }}: {{ property.last }}</span>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- if item.line_level_discount_allocations != blank -%}
            {%- for allocation in item.line_level_discount_allocations -%}
              <span class="cart-item__variant">
                {{ allocation.discount_application.title }} (-{{ allocation.amount | money }})
              </span>
            {%- endfor -%}
          {%- endif -%}

          <div class="cart-item__bottom">
            {% render 'quantity-input',
              input_id: quantity_id,
              value: item.quantity,
              min: 0,
              line: line_number,
              small: true
            %}

            <div class="cart-item__price">
              {%- if item.original_line_price != item.final_line_price -%}
                <s class="price__compare">{{ item.original_line_price | money }}</s>
                <span class="price__current">{{ item.final_line_price | money }}</span>
              {%- else -%}
                <span class="price__current">{{ item.original_line_price | money }}</span>
              {%- endif -%}
            </div>
          </div>

          <button
            type="button"
            class="cart-item__remove"
            data-cart-remove
            data-line="{{ line_number }}"
          >
            {{ 'cart.general.remove' | t }}
            <span class="visually-hidden">{{ 'cart.general.remove_item' | t: title: item.product.title }}</span>
          </button>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</cart-items>
