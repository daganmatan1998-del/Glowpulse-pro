{%- comment -%}
  Renders an inline SVG icon.

  Accepts:
  - name:  {String} icon handle (required)
  - class: {String} extra CSS class (optional)

  Usage:
  {% render 'icon', name: 'cart' %}
{%- endcomment -%}

{%- liquid
  assign stroke_icons = 'menu,close,cart,bag,search,user,plus,minus,chevron-down,chevron-up,chevron-left,chevron-right,arrow-right,arrow-left,check,check-circle,truck,shield,refresh,headset,lock,gift,leaf,heart,clock,box,credit-card,globe,tag,award,phone,mail,map-pin,info,alert,zap,smile,thumbs-up,percent,plane,water-drop,sparkles,play,filter,trash,external-link'
  assign is_stroke = false
  assign parts = stroke_icons | split: ','
  for part in parts
    if part == name
      assign is_stroke = true
      break
    endif
  endfor
-%}

{%- capture svg_attrs -%}
  class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
{%- endcapture -%}

{%- if is_stroke -%}
  <svg {{ svg_attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    {%- case name -%}
      {%- when 'menu' -%}
        <path d="M3 6h18M3 12h18M3 18h18"/>
      {%- when 'close' -%}
        <path d="M18 6 6 18M6 6l12 12"/>
      {%- when 'cart' -%}
        <circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>
        <path d="M2 3h3l2.4 12.1a1.6 1.6 0 0 0 1.6 1.3h8.3a1.6 1.6 0 0 0 1.6-1.3L22 7H6"/>
      {%- when 'bag' -%}
        <path d="M5 8h14l-1 12.5a1.5 1.5 0 0 1-1.5 1.4h-9A1.5 1.5 0 0 1 6 20.5Z"/>
        <path d="M9 8V6a3 3 0 0 1 6 0v2"/>
      {%- when 'search' -%}
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>
      {%- when 'user' -%}
        <circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>
      {%- when 'plus' -%}
        <path d="M12 5v14M5 12h14"/>
      {%- when 'minus' -%}
        <path d="M5 12h14"/>
      {%- when 'chevron-down' -%}
        <path d="m6 9 6 6 6-6"/>
      {%- when 'chevron-up' -%}
        <path d="m6 15 6-6 6 6"/>
      {%- when 'chevron-left' -%}
        <path d="m15 6-6 6 6 6"/>
      {%- when 'chevron-right' -%}
        <path d="m9 6 6 6-6 6"/>
      {%- when 'arrow-right' -%}
        <path d="M4 12h16m-6-6 6 6-6 6"/>
      {%- when 'arrow-left' -%}
        <path d="M20 12H4m6-6-6 6 6 6"/>
      {%- when 'check' -%}
        <path d="m4 12.5 5 5L20 6.5"/>
      {%- when 'check-circle' -%}
        <circle cx="12" cy="12" r="9"/><path d="m8 12.3 2.7 2.7L16 9.7"/>
      {%- when 'truck' -%}
        <path d="M2 6.5h11.5v11H2z"/><path d="M13.5 10H18l4 3.4v4.1h-8.5z"/>
        <circle cx="7" cy="18.5" r="1.8"/><circle cx="17.5" cy="18.5" r="1.8"/>
      {%- when 'shield' -%}
        <path d="M12 2.5 20 6v6c0 4.6-3.2 8.4-8 9.5-4.8-1.1-8-4.9-8-9.5V6Z"/><path d="m8.7 12 2.3 2.3 4.3-4.6"/>
      {%- when 'refresh' -%}
        <path d="M20.5 12a8.5 8.5 0 1 1-2.6-6.1"/><path d="M20.5 4v5h-5"/>
      {%- when 'headset' -%}
        <path d="M4 13v-1a8 8 0 0 1 16 0v1"/>
        <path d="M4 13h2.5a1 1 0 0 1 1 1v4a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1Zm16 0h-2.5a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1H19a1 1 0 0 0 1-1Z"/>
        <path d="M20 19v.5a2.5 2.5 0 0 1-2.5 2.5H13"/>
      {%- when 'lock' -%}
        <rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
      {%- when 'gift' -%}
        <path d="M3 11h18v10H3z"/><path d="M3 7h18v4H3zM12 7v14"/>
        <path d="M12 7S10.5 3 8.5 3a2 2 0 0 0 0 4Zm0 0s1.5-4 3.5-4a2 2 0 0 1 0 4Z"/>
      {%- when 'leaf' -%}
        <path d="M4 20c0-8 6-14 16-14 0 10-5.5 14-11 14a5 5 0 0 1-5-5Z"/><path d="M9 15c2-3 5-5.5 8-7"/>
      {%- when 'heart' -%}
        <path d="M12 20.5C6.5 17 3 13.8 3 9.9A4.4 4.4 0 0 1 7.4 5.5c1.9 0 3.5 1.1 4.6 2.6 1.1-1.5 2.7-2.6 4.6-2.6A4.4 4.4 0 0 1 21 9.9c0 3.9-3.5 7.1-9 10.6Z"/>
      {%- when 'clock' -%}
        <circle cx="12" cy="12" r="9"/><path d="M12 7v5.3l3.4 2"/>
      {%- when 'box' -%}
        <path d="m12 2.8 8.5 4.4v9.6L12 21.2 3.5 16.8V7.2Z"/><path d="M3.5 7.2 12 11.6l8.5-4.4M12 11.6v9.6"/>
      {%- when 'credit-card' -%}
        <rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 10h19"/>
      {%- when 'globe' -%}
        <circle cx="12" cy="12" r="9"/><path d="M3 12h18"/>
        <path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/>
      {%- when 'tag' -%}
        <path d="M11.6 3H21v9.4l-9.3 9.3a1.5 1.5 0 0 1-2.2 0l-7.2-7.2a1.5 1.5 0 0 1 0-2.2Z"/>
        <circle cx="16.6" cy="7.4" r="1.4"/>
      {%- when 'award' -%}
        <circle cx="12" cy="9" r="6"/><path d="m8.5 14.3-1.3 7L12 18.6l4.8 2.7-1.3-7"/>
      {%- when 'phone' -%}
        <path d="M6.5 3h3l1.6 4-2 1.5a12 12 0 0 0 5.4 5.4l1.5-2 4 1.6v3a2 2 0 0 1-2.2 2A17.5 17.5 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"/>
      {%- when 'mail' -%}
        <rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>
      {%- when 'map-pin' -%}
        <path d="M12 21.5S5 15.9 5 10.5a7 7 0 1 1 14 0c0 5.4-7 11-7 11Z"/><circle cx="12" cy="10.3" r="2.6"/>
      {%- when 'info' -%}
        <circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.8v.2"/>
      {%- when 'alert' -%}
        <circle cx="12" cy="12" r="9"/><path d="M12 7.5v5M12 16.2v.2"/>
      {%- when 'zap' -%}
        <path d="M13.5 2 4 13.8h6.5L10 22l9.5-11.8H13Z"/>
      {%- when 'smile' -%}
        <circle cx="12" cy="12" r="9"/><path d="M8.5 14a4.5 4.5 0 0 0 7 0M9 9.5v.2M15 9.5v.2"/>
      {%- when 'thumbs-up' -%}
        <path d="M7 10.5 11 3a2.5 2.5 0 0 1 2.5 2.5V9H19a2 2 0 0 1 2 2.4l-1.4 6.4A2.5 2.5 0 0 1 17.2 20H7Z"/>
        <rect x="2.5" y="10.5" width="4.5" height="9.5" rx="1.2"/>
      {%- when 'percent' -%}
        <path d="M19 5 5 19"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>
      {%- when 'plane' -%}
        <path d="M21 4 3 11l6 2.6L11.5 20Z"/><path d="m9 13.6 3.5-3.5"/>
      {%- when 'water-drop' -%}
        <path d="M12 2.5c4 4.6 6 7.7 6 10.2a6 6 0 0 1-12 0c0-2.5 2-5.6 6-10.2Z"/>
      {%- when 'sparkles' -%}
        <path d="m12 3 1.9 4.9L19 9.8l-5.1 1.9L12 16.6l-1.9-4.9L5 9.8l5.1-1.9Z"/>
        <path d="M18.5 15.5 19.3 18l2.2.8-2.2.8-.8 2.4-.8-2.4-2.2-.8 2.2-.8Z"/>
      {%- when 'play' -%}
        <path d="M8 5.5 19 12 8 18.5Z"/>
      {%- when 'filter' -%}
        <path d="M3 5.5h18l-7 8v6l-4 2v-8Z"/>
      {%- when 'trash' -%}
        <path d="M4 7h16M9.5 7V4.5h5V7M6.5 7l.9 13a1.6 1.6 0 0 0 1.6 1.5h6a1.6 1.6 0 0 0 1.6-1.5l.9-13"/>
      {%- when 'external-link' -%}
        <path d="M14 4h6v6M20 4l-9 9"/><path d="M18 14v5.5a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 3 19.5v-12A1.5 1.5 0 0 1 4.5 6H10"/>
    {%- endcase -%}
  </svg>
{%- else -%}
  <svg {{ svg_attrs }} fill="currentColor">
    {%- case name -%}
      {%- when 'star' -%}
        <path d="m12 2.4 2.9 6.2 6.6.9-4.8 4.7 1.2 6.7L12 17.7l-5.9 3.2 1.2-6.7L2.5 9.5l6.6-.9Z"/>
      {%- when 'star-half' -%}
