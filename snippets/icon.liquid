      {%- when 'snapchat' -%}
        <path d="M12 2c2.9 0 5 2.2 5 5.1 0 .9-.1 1.8-.1 2.3.4.2.9.1 1.4-.1.5-.2 1 .1 1.1.5.1.5-.2.9-.9 1.2-.7.3-1.5.5-1.5 1 0 .6 1.6 3 4 3.6.4.1.6.4.5.8-.2.7-1.6 1-2.6 1.2-.2.4-.2 1-.5 1.2-.3.2-1-.1-1.9-.1-1.3 0-1.9 1.3-3.5 1.3s-2.2-1.3-3.5-1.3c-.9 0-1.6.3-1.9.1-.3-.2-.3-.8-.5-1.2-1-.2-2.4-.5-2.6-1.2-.1-.4.1-.7.5-.8 2.4-.6 4-3 4-3.6 0-.5-.8-.7-1.5-1-.7-.3-1-.7-.9-1.2.1-.4.6-.7 1.1-.5.5.2 1 .3 1.4.1 0-.5-.1-1.4-.1-2.3C7 4.2 9.1 2 12 2Z"/>
