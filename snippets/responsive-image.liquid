{%- comment -%}
  Renders an image inside a fixed-ratio box, with an optional separate mobile
  image and separate mobile/desktop ratios so nothing is ever cropped badly.

  Accepts:
  - image:          {Object} desktop image (optional — falls back to a placeholder)
  - image_mobile:   {Object} optional art-directed mobile image
  - ratio_desktop:  {String} square | portrait | tall | landscape | wide | ultrawide
  - ratio_mobile:   {String} same options (defaults to ratio_desktop)
  - fit:            {String} cover | contain (default cover)
  - radius:         {Number} border radius in px
  - sizes:          {String} sizes attribute (default '100vw')
  - loading:        {String} lazy | eager (default lazy)
  - priority:       {Boolean} sets fetchpriority="high"
  - alt:            {String} overrides the image alt text
  - placeholder:    {String} Shopify placeholder name (default 'lifestyle-1')

  Usage:
  {% render 'responsive-image', image: block.settings.image, ratio_desktop: 'square' %}
{%- endcomment -%}

{%- liquid
  assign fit_class = ''
  if fit == 'contain'
    assign fit_class = ' media--contain'
  endif

  assign img_loading = loading | default: 'lazy'
  assign img_sizes = sizes | default: '100vw'
  assign placeholder_name = placeholder | default: 'lifestyle-1'

  assign ratio_css_desktop = '1 / 1'
  case ratio_desktop
    when 'portrait'
      assign ratio_css_desktop = '4 / 5'
    when 'tall'
      assign ratio_css_desktop = '3 / 4'
    when 'landscape'
      assign ratio_css_desktop = '4 / 3'
    when 'wide'
      assign ratio_css_desktop = '16 / 9'
    when 'ultrawide'
      assign ratio_css_desktop = '21 / 9'
  endcase

  assign mobile_key = ratio_mobile | default: ratio_desktop
  assign ratio_css_mobile = '1 / 1'
  case mobile_key
    when 'portrait'
      assign ratio_css_mobile = '4 / 5'
    when 'tall'
      assign ratio_css_mobile = '3 / 4'
    when 'landscape'
      assign ratio_css_mobile = '4 / 3'
    when 'wide'
      assign ratio_css_mobile = '16 / 9'
    when 'ultrawide'
      assign ratio_css_mobile = '21 / 9'
  endcase
-%}

<div
  class="media media--responsive{{ fit_class }}"
  style="--ratio-mobile: {{ ratio_css_mobile }}; --ratio-desktop: {{ ratio_css_desktop }};{% if radius %} border-radius: {{ radius }}px;{% endif %}"
>
  {%- if image != blank -%}
    <picture>
      {%- if image_mobile != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ image_mobile | image_url: width: 500 }} 500w,
            {{ image_mobile | image_url: width: 750 }} 750w,
            {{ image_mobile | image_url: width: 1100 }} 1100w
          "
          sizes="{{ img_sizes }}"
        >
      {%- endif -%}
      <img
        src="{{ image | image_url: width: 1400 }}"
        srcset="
          {{ image | image_url: width: 500 }} 500w,
          {{ image | image_url: width: 750 }} 750w,
          {{ image | image_url: width: 1000 }} 1000w,
          {{ image | image_url: width: 1400 }} 1400w,
          {{ image | image_url: width: 1800 }} 1800w
        "
        sizes="{{ img_sizes }}"
        alt="{{ alt | default: image.alt | escape }}"
        width="{{ image.width }}"
        height="{{ image.height }}"
        loading="{{ img_loading }}"
        {% if priority %}fetchpriority="high"{% endif %}
      >
    </picture>
  {%- else -%}
    {{ placeholder_name | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
</div>
