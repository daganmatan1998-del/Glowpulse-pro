<div class="page-width">
  <div class="customer customer--narrow">
    <div class="page-hero">
      <h1>{{ 'customer.activate_account.title' | t }}</h1>
      <p class="text-muted">{{ 'customer.activate_account.subtext' | t }}</p>
    </div>

    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error">
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
        <input type="password" id="ActivatePassword" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="field">
        <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
        <input type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button button--full button--large">
        {{ 'customer.activate_account.submit' | t }}
      </button>

      <button type="submit" name="decline" class="button button--ghost button--full" style="margin-top:10px;">
        {{ 'customer.activate_account.cancel' | t }}
      </button>
    {%- endform -%}
  </div>
</div>
