<div class="page-width">
  <div class="customer">
    <div class="page-hero" style="text-align:left;">
      <h1>{{ 'customer.addresses.title' | t }}</h1>
      <a class="button button--ghost" href="{{ routes.account_url }}">{{ 'customer.account.return' | t }}</a>
    </div>

    <details class="facet-details" style="margin-bottom:32px;">
      <summary>{% render 'icon', name: 'plus' %} {{ 'customer.addresses.add_new' | t }}</summary>
      <div style="margin-top:20px; max-width:560px;">
        {%- form 'customer_address', customer.new_address -%}
          <div class="grid grid--2">
            <div class="field">
              <label class="field__label" for="AddressFirstNameNew">{{ 'customer.addresses.first_name' | t }}</label>
              <input type="text" id="AddressFirstNameNew" name="address[first_name]" autocomplete="given-name">
            </div>
            <div class="field">
              <label class="field__label" for="AddressLastNameNew">{{ 'customer.addresses.last_name' | t }}</label>
              <input type="text" id="AddressLastNameNew" name="address[last_name]" autocomplete="family-name">
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="AddressCompanyNew">{{ 'customer.addresses.company' | t }}</label>
            <input type="text" id="AddressCompanyNew" name="address[company]" autocomplete="organization">
          </div>

          <div class="field">
            <label class="field__label" for="AddressLine1New">{{ 'customer.addresses.address1' | t }}</label>
            <input type="text" id="AddressLine1New" name="address[address1]" autocomplete="address-line1">
          </div>

          <div class="field">
            <label class="field__label" for="AddressLine2New">{{ 'customer.addresses.address2' | t }}</label>
            <input type="text" id="AddressLine2New" name="address[address2]" autocomplete="address-line2">
          </div>

          <div class="grid grid--2">
            <div class="field">
              <label class="field__label" for="AddressCityNew">{{ 'customer.addresses.city' | t }}</label>
              <input type="text" id="AddressCityNew" name="address[city]" autocomplete="address-level2">
            </div>
            <div class="field">
              <label class="field__label" for="AddressZipNew">{{ 'customer.addresses.zip' | t }}</label>
              <input type="text" id="AddressZipNew" name="address[zip]" autocomplete="postal-code">
            </div>
          </div>

          <div class="grid grid--2">
            <div class="field">
              <label class="field__label" for="AddressCountryNew">{{ 'customer.addresses.country' | t }}</label>
              <select id="AddressCountryNew" name="address[country]" data-default="">
                {{ country_option_tags }}
              </select>
            </div>
            <div class="field">
              <label class="field__label" for="AddressPhoneNew">{{ 'customer.addresses.phone' | t }}</label>
              <input type="tel" id="AddressPhoneNew" name="address[phone]" autocomplete="tel">
            </div>
          </div>

          <label class="checkbox-row" style="margin-bottom:16px;">
            {{ form.set_as_default_checkbox }}
            <span>{{ 'customer.addresses.set_default' | t }}</span>
          </label>

          <button type="submit" class="button">{{ 'customer.addresses.add' | t }}</button>
        {%- endform -%}
      </div>
    </details>

    {%- paginate customer.addresses by 6 -%}
      <div class="customer-address-list">
        {%- for address in customer.addresses -%}
          <div class="customer-address">
            {%- if address == customer.default_address -%}
              <span class="badge" style="margin-bottom:10px;">Default</span>
            {%- endif -%}
            {{ address | format_address }}

            <div class="button-group" style="margin-top:12px;">
              <details>
                <summary class="button button--small button--secondary" style="cursor:pointer;">
                  {{ 'customer.addresses.edit' | t }}
                </summary>
                <div style="margin-top:16px;">
                  {%- form 'customer_address', address -%}
                    <div class="field">
                      <label class="field__label" for="AddressLine1-{{ address.id }}">{{ 'customer.addresses.address1' | t }}</label>
                      <input type="text" id="AddressLine1-{{ address.id }}" name="address[address1]" value="{{ address.address1 }}">
                    </div>
                    <div class="field">
                      <label class="field__label" for="AddressCity-{{ address.id }}">{{ 'customer.addresses.city' | t }}</label>
                      <input type="text" id="AddressCity-{{ address.id }}" name="address[city]" value="{{ address.city }}">
                    </div>
                    <div class="field">
                      <label class="field__label" for="AddressZip-{{ address.id }}">{{ 'customer.addresses.zip' | t }}</label>
                      <input type="text" id="AddressZip-{{ address.id }}" name="address[zip]" value="{{ address.zip }}">
                    </div>
                    <div class="field">
                      <label class="field__label" for="AddressCountry-{{ address.id }}">{{ 'customer.addresses.country' | t }}</label>
                      <select id="AddressCountry-{{ address.id }}" name="address[country]" data-default="{{ address.country }}">
                        {{ country_option_tags }}
                      </select>
                    </div>
                    <button type="submit" class="button button--small">{{ 'customer.addresses.update' | t }}</button>
                  {%- endform -%}
                </div>
              </details>

              <form method="post" action="{{ address.url }}" data-confirm-delete>
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="button button--small button--ghost">
                  {{ 'customer.addresses.delete' | t }}
                </button>
              </form>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

<script>
  // Preselect the country each saved address was created with.
  document.querySelectorAll('select[name="address[country]"]').forEach(function (select) {
    var preset = select.getAttribute('data-default');
    if (preset) select.value = preset;
  });

  document.querySelectorAll('[data-confirm-delete]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (!window.confirm({{ 'customer.addresses.delete_confirm' | t | json }})) event.preventDefault();
    });
  });
</script>
