<div class="page-width" style="padding-block: 56px 72px;">
  <div class="customer">
    <h1>{{ 'customer.reset_password.title' | t }}</h1>
    <p class="text-small text-muted text-center">{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password', class: 'form-stack' -%}
      {%- if form.errors -%}
        <p class="form__message form__message--error">{{ form.errors.messages.form }}</p>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input class="field__input" id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input class="field__input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>
