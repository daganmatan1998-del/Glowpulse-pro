<div class="page-width">
  <div class="customer customer--narrow">
    <div class="page-hero">
      <h1>{{ 'customer.reset_password.title' | t }}</h1>
      <p class="text-muted">{{ 'customer.reset_password.subtext' | t }}</p>
    </div>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-status form-status--error">
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>

      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button button--full button--large">
        {{ 'customer.reset_password.submit' | t }}
      </button>
    {%- endform -%}
  </div>
</div>
