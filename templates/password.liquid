{% layout 'password' %}

<h1 class="h3">{{ page_title | default: 'Opening soon' }}</h1>

{%- if shop.password_message != blank -%}
  <div class="rte text-muted">{{ shop.password_message }}</div>
{%- else -%}
  <p class="text-muted">We are putting the finishing touches on the store. Leave your email and we will let you know the moment we open.</p>
{%- endif -%}

{%- form 'storefront_password', class: 'password-form' -%}
  {%- if form.errors -%}
    <p class="form-status form-status--error" style="margin-top:20px;">
      {{ 'general.password_page.login_form_error' | t }}
    </p>
  {%- endif -%}

  <div style="display:flex; gap:8px; margin-top:20px;">
    <input
      type="password"
      name="password"
      placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
      aria-label="{{ 'general.password_page.login_form_password_label' | t }}"
      autocomplete="current-password"
    >
    <button type="submit" class="button">{{ 'general.password_page.login_form_submit' | t }}</button>
  </div>
{%- endform -%}

{%- form 'customer', class: 'password-newsletter' -%}
  <input type="hidden" name="contact[tags]" value="prelaunch">

  {%- if form.posted_successfully? -%}
    <p class="form-status form-status--success" style="margin-top:20px;">
      Thanks. We will email you when we open.
    </p>
  {%- else -%}
    <div style="display:flex; gap:8px; margin-top:12px;">
      <input
        type="email"
        name="contact[email]"
        placeholder="you@example.com"
        aria-label="Email"
        autocomplete="email"
        required
      >
      <button type="submit" class="button button--secondary">Notify me</button>
    </div>
  {%- endif -%}
{%- endform -%}
