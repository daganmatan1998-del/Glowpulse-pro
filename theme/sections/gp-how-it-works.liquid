{%- render 'gp-assets' -%}

<section class="gp-section gp-section--muted gp-steps" id="gp-how" style="padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <div class="gp-wrap">
    <div class="gp-head gp-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="gp-h2">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="gp-lede">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <ol class="gp-grid" style="list-style:none;margin:0;padding:0;">
      {%- for block in section.blocks -%}
        <li class="gp-card gp-reveal" data-gp-delay="{{ forloop.index0 | times: 80 }}" {{ block.shopify_attributes }}>
          <span class="gp-step__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="gp-h3">{{ block.settings.title | escape }}</h3>
          <p class="gp-body" style="color:var(--gp-secondary)">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "GP How it works",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps, ten minutes" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Hands-free and cordless, so a session fits into whatever you were already doing." },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 24, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 24, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cleanse and dry" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Start on bare skin so nothing blocks the light." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GP How it works",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
