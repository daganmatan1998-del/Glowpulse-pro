{%- comment -%}
  Inline SVG icon set (Lucide-derived paths). No emoji, no icon font.
  Accepts: icon (string), class (string, optional)
{%- endcomment -%}
{%- case icon -%}
  {%- when 'sparkles' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9z"/><path d="M19 15l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
  {%- when 'clock' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3l7 3v5.5c0 4.3-2.9 8-7 9.5-4.1-1.5-7-5.2-7-9.5V6z"/><path d="M9.5 12.2l1.8 1.8 3.4-3.6"/></svg>
  {%- when 'truck' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h11v9H3z"/><path d="M14 9h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg>
  {%- when 'leaf' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 4c0 8-4.5 13-10.5 13A5.5 5.5 0 0 1 4 11.5C4 6 9.5 4 20 4z"/><path d="M4 20c3-5 7-8 12-10"/></svg>
  {%- when 'battery' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.5" y="8" width="16" height="9" rx="2.5"/><path d="M21.5 11.5v2"/><path d="M6.5 12.5h5"/></svg>
  {%- when 'award' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.8L7 21l5-2.6L17 21l-1.5-7.2"/></svg>
  {%- when 'undo' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 9h11a5.5 5.5 0 0 1 0 11h-4"/><path d="M6.5 5.5L3 9l3.5 3.5"/></svg>
  {%- when 'check' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.7a8.3 8.3 0 100 16.6 8.3 8.3 0 000-16.6zm4.1 6.2l-4.8 5a.9.9 0 01-1.3 0L5.9 10.8a.9.9 0 111.3-1.3l1.5 1.6 4.1-4.4a.9.9 0 111.3 1.2z"/></svg>
  {%- when 'cross' -%}
    <svg class="{{ class }}" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.7a8.3 8.3 0 100 16.6 8.3 8.3 0 000-16.6zm3 10.1a.9.9 0 11-1.2 1.2L10 11.2l-1.8 1.8A.9.9 0 117 11.8L8.8 10 7 8.2A.9.9 0 118.2 7L10 8.8 11.8 7A.9.9 0 1113 8.2L11.2 10z"/></svg>
  {%- when 'chevron' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6"/></svg>
{%- endcase -%}
